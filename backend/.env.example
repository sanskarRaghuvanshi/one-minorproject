# OneSpace Backend Environment Configuration
# Copy this to .env and fill in real values before running.

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://your-cluster.mongodb.net

# Database name (default: onespace)
MONGODB_DB_NAME=onespace

# JWT secret (required - must be strong)
JWT_SECRET=replace-with-a-strong-secret

# JWT expiry in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# CORS origins (comma-separated, development defaults)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080