# OneSpace Backend Environment Configuration
# Copy this to .env for local development, or add these in Render Dashboard -> Environment Variables.

# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name (default: onespace_db)
DATABASE_NAME=onespace_db
MONGODB_DB_NAME=onespace_db

# JWT secret (required - generate a random strong 32+ char string)
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars

# JWT algorithm & expiry
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production toggle
USE_MOCK_DATA=false

# Allowed CORS Origins (comma-separated).
# Add your Vercel deployment URL here (e.g. https://your-project.vercel.app)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# CORS Origin Regex for Vercel preview and production subdomains
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
